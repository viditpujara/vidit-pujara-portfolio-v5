# Canonical production origin. No trailing slash.
# Every canonical URL, Open Graph URL, sitemap entry and JSON-LD id is built from this.
NEXT_PUBLIC_SITE_URL=https://viditpujara.me

# Set to exactly "production" on the production deployment only.
# Any other value ships noindex on every route and a disallow-all robots.txt,
# which is what preview deployments should do.
NEXT_PUBLIC_SITE_ENV=preview

# Optional. Google Search Console HTML tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
