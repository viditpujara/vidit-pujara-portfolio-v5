{
  "name": "vidit-pujara-portfolio-v5",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/environment.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:browser": "playwright test",
    "qa": "python3 scripts/qa-sweep.py",
    "resume:build": "python3 scripts/build-resume.py",
    "security:scan": "python3 scripts/scan-secrets.py"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.56.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
